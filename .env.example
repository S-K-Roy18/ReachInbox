# Docker Compose PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Ethereal SMTP credentials used only for captured test delivery
ETHEREAL_USER=your_ethereal_username
ETHEREAL_PASS=your_ethereal_password

# Frontend API Base URL (used by Vite in browser)
# Local development default: http://localhost:4000
# Production (e.g., Vercel): https://reachinbox-hypy.onrender.com
VITE_API_URL=http://localhost:4000
