PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
SESSION_SECRET=your_session_secret
NODE_ENV=development
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ETHEREAL_USER=your_ethereal_username
ETHEREAL_PASS=your_ethereal_password

# Optional Slack integration. Configure all five values to enable Slack OAuth.
# Register http://localhost:4000/api/integrations/slack/callback as the redirect URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback
SLACK_FRONTEND_REDIRECT_URL=http://localhost:5173/?slack=connected
# Generate a unique 32-byte key and encode it as 64 hexadecimal characters.
SLACK_TOKEN_ENCRYPTION_KEY=

# Optional Elasticsearch search/indexing service
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# Comma-separated Google OAuth account emails allowed to access the read-only queue dashboard
BULL_BOARD_ADMIN_EMAILS=
