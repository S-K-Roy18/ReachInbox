{
  "name": "reachinbox-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "test": "npm run test:pipeline",
    "test:pipeline": "node -r ts-node/register/transpile-only test-pipeline.ts",
    "test:campaigns": "node -r ts-node/register/transpile-only test-campaigns.ts",
    "test:rate-limits": "node -r ts-node/register/transpile-only test-rate-limits.ts",
    "test:slack": "node -r ts-node/register/transpile-only test-slack.ts",
    "test:elasticsearch": "node -r ts-node/register/transpile-only test-elasticsearch.ts",
    "test:bull-board": "node -r ts-node/register/transpile-only test-bull-board.ts",
    "smtp:verify": "node -r ts-node/register/transpile-only scripts/verify-smtp.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@prisma/client": "^5.0.0",
    "bullmq": "^6.4.1",
    "connect-pg-simple": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.2.1",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.6",
    "@types/node": "^20.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.11",
    "prisma": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
